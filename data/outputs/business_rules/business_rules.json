    "id": "BR004",
    "description": "Determine customer status based on transaction amount",
    "logic": "IF WS-TRANSACTION-AMT < 0 THEN MOVE 'D' TO WS-CUST-STATUS ELSE MOVE 'A' TO WS-CUST-STATUS END-IF",
    "complexity": "medium",
    "inputs": [
      "WS-TRANSACTION-AMT"
    ],
    "outputs": [
