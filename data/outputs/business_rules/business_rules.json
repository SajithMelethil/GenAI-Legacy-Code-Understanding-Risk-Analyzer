  {
    "id": "BR005",
    "description": "Calculate new balance",
    "logic": "COMPUTE WS-NEW-BALANCE = WS-CUST-BALANCE + WS-TRANSACTION-AMT",
    "complexity": "medium",
    "inputs": [
      "WS-CUST-BALANCE",
      "WS-TRANSACTION-AMT"
    ],
    "outputs": [
